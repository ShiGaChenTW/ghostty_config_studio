# Compiled TUI binary — build it with: cd tui && go build -o ../ghostty-tui .
/ghostty-tui

# Optional config packs are fetched on demand by ghostty-setup into
# ~/.config/ghostty-config-studio/assets — deliberately outside this tree, so
# they survive brew upgrades and belong to their upstream authors, not us.

# macOS
.DS_Store

# Local working notes and agent scratch space — workflow, not product.
/plans/
/.claude/

# Stray `go build` output left inside tui/ — the real target is /ghostty-tui,
# built with `cd tui && go build -o ../ghostty-tui .`
/tui/tui
/tui/ghosttytui
