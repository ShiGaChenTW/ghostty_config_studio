#!/usr/bin/env bash
# Interactive picker over naydenoff/ghostty-config's 4 font configs.
#
#   ghostty-font              interactive numbered menu
#   ghostty-font <name>       switch directly, e.g. `ghostty-font iosevka`
#   ghostty-font --current    show every category's active selection
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/menu.sh
source "$SCRIPT_DIR/lib/menu.sh"

if [ "${1:-}" = "--current" ]; then show_current; exit 0; fi

names=(); descs=(); paths=(); shader_srcs=(); kinds=(); sources=()

font_desc() {
  case "$1" in
    cascadia-code)  echo "Cascadia Code -- Microsoft's modern font, excellent cursive italics" ;;
    fira-code)      echo "Fira Code -- beautiful coding ligatures, clean and programming-focused" ;;
    iosevka)        echo "Iosevka -- ultra-narrow, space-efficient, maximizes code density" ;;
    jetbrains-mono) echo "JetBrains Mono -- excellent readability, built-in ligatures" ;;
    *)              echo "$1" ;;
  esac
}

for f in "$STUDIO_ASSETS"/fonts/*.conf; do
  [ -f "$f" ] || continue
  name="$(basename "$f" .conf)"
  names+=("$name"); descs+=("$(font_desc "$name")"); paths+=("$f"); shader_srcs+=(""); sources+=("naydenoff")
done

# Your own font configs. Kept outside assets/ on purpose: that directory
# belongs to the imported packs, and removing a pack takes the whole thing
# with it. Anything here survives that, and survives never importing at all.
for f in "$STUDIO_DIR"/fonts/*.conf; do
  [ -f "$f" ] || continue
  name="$(basename "$f" .conf)"
  desc="$(grep -m1 '^# ' "$f" | sed 's/^# //')"
  [ -n "$desc" ] || desc="$(t "你自己的字型設定" "your own font config")"
  names+=("$name"); descs+=("$desc"); paths+=("$f"); shader_srcs+=(""); sources+=("you")
done

run_picker font Font "${1:-}"
